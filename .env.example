VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
# A SECRET MUST NOT CARRY THE VITE_ PREFIX.
#
# Vite's dev server does not substitute one property of import.meta.env — it inlines the WHOLE
# object into every module that touches it, so a VITE_-prefixed secret is served to the browser
# inside unrelated files. A key was disclosed exactly that way, out of src/lib/appMode.ts, which
# only asks whether this is the public build.
#
# This one is read server-side by vite.config.ts and attached to /anthropic-proxy requests there,
# so browser JavaScript never holds it. The desktop build gets its own copy from the Rust backend.
ANTHROPIC_API_KEY=your_anthropic_api_key
