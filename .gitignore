# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets — .env holds the live Anthropic API key. The repo is PUBLIC; pushing source
# without this ignored publishes the key and anyone can spend against the account.
.env
.env.*
!.env.example
!.env.production
!.env.public

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Data snapshots — local rollback points, not for the repo or the website
.snapshots/

# Re-downloadable audit input (unlike references.jsonl, which is the only copy)
scripts/.cache/qalerts-posts.json

# Built by scripts/build-media-bundle.mjs — ~155 MB of re-encoded attachments.
# Derived data, rebuildable, and far too large for git. Shipped to CI as a release asset.
media-bundle/

# Runtime single-writer lock — never a tracked artifact.
.repo-lock.json

# A navigation index over DEVLOG.md — start line, heading, length, one row per `## ` section.
# Purely derived: it can be rebuilt from DEVLOG.md at any moment, and it goes stale the moment
# DEVLOG.md is appended to, which happens every session. Tracking it would mean a conflicting
# diff on every commit for a file nothing reads but a session's own navigation.
scripts/.devlog-index.tsv

# The validation receipt written by scripts/validate.mjs and read by scripts/preflight-deploy.mjs.
# It records WHICH bytes passed WHICH profile on this machine; it is local evidence about a local
# run, never a fact about the repo.
.validate-receipt.json
