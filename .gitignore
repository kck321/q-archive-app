# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets — .env holds the live Anthropic API key. The repo is PUBLIC; pushing source
# without this ignored publishes the key and anyone can spend against the account.
.env
.env.*
!.env.example
!.env.production
!.env.public

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Data snapshots — local rollback points, not for the repo or the website
.snapshots/

# Re-downloadable audit input (unlike references.jsonl, which is the only copy)
scripts/.cache/qalerts-posts.json

# Built by scripts/build-media-bundle.mjs — ~155 MB of re-encoded attachments.
# Derived data, rebuildable, and far too large for git. Shipped to CI as a release asset.
media-bundle/

# Runtime single-writer lock — never a tracked artifact.
.repo-lock.json

# A navigation index over DEVLOG.md — start line, heading, length, one row per `## ` section.
# Purely derived: it can be rebuilt from DEVLOG.md at any moment, and it goes stale the moment
# DEVLOG.md is appended to, which happens every session. Tracking it would mean a conflicting
# diff on every commit for a file nothing reads but a session's own navigation.
scripts/.devlog-index.tsv

# The validation receipt written by scripts/validate.mjs and read by scripts/preflight-deploy.mjs.
# It records WHICH bytes passed WHICH profile on this machine; it is local evidence about a local
# run, never a fact about the repo.
.validate-receipt.json

# The throwaway production build and the measurement dumps used by scripts/perf-baseline.mjs.
# NEVER build into dist/: dist/build-info.json is the only local record of what production is
# serving, and vite build empties the directory it writes to.
.perf-*

# Bulk regenerable audit output. `node scripts/audit-unhighlighted-sentences.mjs` rebuilds these
# two in ~3s and the JSONL embeds every post body, so it lands at 34MB — four times the largest
# artifact the repo tracks. The manifest, README, per-bucket CSVs, distinct-wordings CSV and the
# workbook ARE committed, because those are the deliverable.
audit/unhighlighted-sentences/unhighlighted-sentences.jsonl
audit/unhighlighted-sentences/unhighlighted-sentences.csv
# Same shape: the census JSONL with a proposal object added to every row, 26MB.
# `node scripts/classify-unhighlighted-residual.mjs` rebuilds it from the census in ~2s.
audit/unhighlighted-sentences/residual-classified.jsonl
# The ground-truth crawl: every painted <mark> range read out of the published site's DOM (7MB),
# and the units measured against it (20MB). `audit-painted-truth.mjs` re-crawls all 4,735 drops in
# ~7 minutes. truth-manifest.json IS committed — it is the evidence, and it is small.
audit/unhighlighted-sentences/painted-truth.jsonl
audit/unhighlighted-sentences/unhighlighted-from-truth.jsonl

# Excel writes a ~$name.xlsx lock file beside any workbook you have open. The review workbook
# lives in audit/, so opening it makes the tree dirty and preflight-deploy refuses to publish —
# a deploy blocked by a spreadsheet being open is not a signal anyone wants.
~$*

# Scratch browser probes. A one-off written to confirm a single change, named with a leading
# underscore, is not a gate and must not become a permanent script — anything under scripts/
# raises the validation floor to certified for every future deploy.
scripts/_*.mjs

# Editorial working files about named people — deliberately NOT in the public repo.
# The site never serves them (vite.config's editorialQueues middleware is dev-only and the
# public flag refuses them even there), but the repo is public for GitHub Pages, so keeping
# them tracked published on GitHub the very drafts the site withholds. Untracked 2026-08-28
# as part of the legality review; the files stay on the owner's machine for the editorial
# workflow, and hover-review work happens locally.
audit/entity-hover-review-queue.json
audit/entity-hover-url-quarantine.json
audit/entity-hover-withdrawn.json
