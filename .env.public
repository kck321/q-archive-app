# Loaded only when Vite runs with `--mode public` (npm run dev:public / preview:public).
# Mirrors what scripts/deploy-web.sh sets for the real GitHub Pages build, so you can
# see EXACTLY what the public gets — read-only, no editing controls compiled in.
VITE_PUBLIC_SITE=1

# The public build must never carry the Anthropic key (same rule as .env.production).
VITE_ANTHROPIC_API_KEY=
