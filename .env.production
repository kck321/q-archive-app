# Production builds (the desktop app) must NOT embed the Anthropic API key.
# It is resolved at RUNTIME by the Tauri backend (`get_anthropic_key`):
#   1. the ANTHROPIC_API_KEY environment variable, or
#   2. <app_config_dir>/anthropic_key.txt   (Windows: %APPDATA%\com.qarchive.desktop\anthropic_key.txt)
# A shared copy with neither has no key, so the AI features stay disabled — it can't
# spend on your account. (Dev `npm run dev` still uses the key in .env.)
VITE_ANTHROPIC_API_KEY=
